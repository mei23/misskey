{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:base"
	],
	"packageRules": [
		{
			"matchPackageNames": ["@fortawesome/fontawesome-svg-core", "@fortawesome/free-brands-svg-icons", "@fortawesome/free-regular-svg-icons", "@fortawesome/free-solid-svg-icons"],
			"allowedVersions": "< 6"
		},
		{
			"matchPackageNames": ["chalk"],
			"allowedVersions": "< 5"
		},
		{
			"matchPackageNames": ["got"],
			"allowedVersions": "< 12"
		},
		{
			"matchPackageNames": ["private-ip"],
			"allowedVersions": "< 3"
		},
		{
			"matchPackageNames": ["redis-lock"],
			"allowedVersions": "< 1"
		},
		{
			"matchPackageNames": ["xev"],
			"allowedVersions": "< 3"
		}
	]
}
